+import os, json, pandas as pd, matplotlib.pyplot as plt
+from jinja2 import Environment, FileSystemLoader
+from weasyprint import HTML
+import sys
+
+DATA_DIR = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'data'))
+OUTPUT_DIR = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'reports'))
+os.makedirs(OUTPUT_DIR, exist_ok=True)
+
+def load_data():
+    # asume archivos JSON por zona en data/*.json
+    json_files = [f for f in os.listdir(DATA_DIR) if f.endswith('.json')]
+    if not json_files:
+        print(f"Error: No JSON files found in {DATA_DIR}")
+        sys.exit(1)
+    records = []
+    for f in json_files:
+        with open(os.path.join(DATA_DIR, f)) as fp:
+            data = json.load(fp)
+            # If the JSON is a list of objects, extend; if it's a single object, append
+            if isinstance(data, list):
+                for item in data:
+                    item['zone'] = f.replace('.json','')
+                    records.append(item)
+            else:
+                data['zone'] = f.replace('.json','')
+                records.append(data)
+    return pd.DataFrame(records)
+
+def stats(df):
+    out = []
+    for zone, g in df.groupby('zone'):
+        price_m2 = g['price'].sum() / g['area'].sum()
+        stock = len(g)
+        variation = (g['price'].pct_change().mean() or 0) * 100
+        out.append({'zone':zone,'price_m2':price_m2,'stock':stock,'variation':variation})
+    return pd.DataFrame(out)
+
+def plot(df):
+    fig, ax = plt.subplots(figsize=(8,4))
+    ax.bar(df['zone'], df['price_m2'])
+    ax.set_ylabel('Precio $/m²')
+    plt.tight_layout()
+    img_path = os.path.join(OUTPUT_DIR,'price_m2.png')
+    plt.savefig(img_path)
+    plt.close()
+    return img_path
+
+def render_pdf(stats_df, img_path, out_path):
+    env = Environment(loader=FileSystemLoader(os.path.dirname(__file__)))
+    tmpl = env.from_string('''
+    <h1>Informe de mercado inmobiliario</h1>
+    <table border="1" cellpadding="5" cellspacing="0">
+      <tr><th>Zona</th><th>Precio m²</th><th>Stock</th><th>Variación %</th></tr>
+      {% for row in rows %}
+      <tr><td>{{row.zone}}</td><td>{{\"%0.2f\"|format(row.price_m2)}}</td><td>{{row.stock}}</td><td>{{\"%0.2f\"|format(row.variation)}}</td></tr>
+      {% endfor %}
+    </table>
+    <img src="{{img}}" style="width:100%;margin-top:20px;"/>
+    ''')
+    html = tmpl.render(rows=stats_df.to_dict('records'), img=img_path)
+    HTML(string=html).write_pdf(out_path)
+
+def main():
+    df = load_data()
+    stats_df = stats(df)
+    img = plot(stats_df)
+    out_pdf = os.path.join(OUTPUT_DIR, 'informe_mercado.pdf')
+    render_pdf(stats_df, img, out_pdf)
+    print('PDF generado:', out_pdf)
+
+if __name__ == '__main__':
+    main()
