+#!/usr/bin/env python3
+import json
+import pandas as pd
+import os
+from reportlab.lib.pagesizes import A4
+from reportlab.platypus import SimpleDocTemplate, Table, TableStyle, Paragraph, Spacer
+from reportlab.lib import colors
+from reportlab.lib.styles import getSampleStyleSheet
+import datetime
+
+DATA_PATH = os.path.expanduser("data/sample_properties.csv")
+OUT_DIR = os.path.expanduser("reports")
+os.makedirs(OUT_DIR, exist_ok=True)
+
+def clean_price(price_str):
+    """Convertir cadena de precio a float, eliminando símbolos."""
+    return float(price_str.replace("$", "").replace(",", ""))
+
+def clean_price_per_m2(price_per_m2_str):
+    """Convertir cadena de precio por m2 a float."""
+    return float(price_per_m2_str.replace("$", "").replace(",", ""))
+
+def clean_m2(m2_str):
+    """Convertir cadena de m2 a float."""
+    return float(m2_str)
+
+def load_data():
+    """Cargar y limpiar los datos."""
+    df = pd.read_csv(DATA_PATH)
+    df['price'] = df['price'].apply(clean_price)
+    df['price_per_m2'] = df['price_per_m2'].apply(clean_price_per_m2)
+    df['m2'] = df['m2'].apply(clean_m2)
+    df['scraped_at'] = pd.to_datetime(df['scraped_at'])
+    return df
+
+def generate_report():
+    """Generar informe de mercado por zona."""
+    df = load_data()
+    
+    # Agrupar por zona y calcular métricas
+    grouped = df.groupby('location').agg(
+        stock=('title', 'count'),
+        precio_m2_mean=('price_per_m2', 'mean'),
+        precio_m2_std=('price_per_m2', 'std'),
+        precio_min=('price_per_m2', 'min'),
+        precio_max=('price_per_m2', 'max'),
+        m2_mean=('m2', 'mean')
+    ).reset_index()
+    
+    # Añadir variación mensual aproximada (comparación con el mes anterior)
+    df['month'] = df['scraped_at'].dt.to_period('M')
+    grouped['month'] = df.groupby('location')['month'].nunique()
+    
+    # Crear PDF
+    pdf_path = os.path.join(OUT_DIR, "informe_mercado.pdf")
+    doc = SimpleDocTemplate(pdf_path, pagesize=A4)
+    elements = []
+    styles = getSampleStyleSheet()
+    
+    # Título
+    elements.append(Paragraph("Informe de Mercado Inmobiliario", styles['Title']))
+    elements.append(Spacer(1, 12))
+    
+    # Tabla de métricas por zona
+    data = [
+        ["Zona", "Stock", "Precio medio (€/m²)", "Desv. estándar", "Precio mínimo", "Precio máximo", "Metros cuadrados promedio", "Mes(es) de datos"]
+    ]
+    for _, row in grouped.iterrows():
+        data.append([
+            row['location'],
+            int(row['stock']),
+            f"{row['precio_m2_mean']:.2f}",
+            f"{row['precio_m2_std']:.2f}",
+            f"{row['precio_min']:.2f}",
+            f"{row['precio_max']:.2f}",
+            f"{row['m2_mean']:.1f}",
+            row['month']
+        ])
+    
+    t = Table(data, hAlign='LEFT')
+    t.setStyle(TableStyle([
+        ('BACKGROUND', (0, 0), (-1, 0), colors.grey),
+        ('TEXTCOLOR', (0, 0), (-1, 0), colors.whitesmoke),
+        ('ALIGN', (0, 0), (-1, -1), 'CENTER'),
+        ('GRID', (0, 0), (-1, -1), 0.5, colors.black),
+        ('ROWBACKGROUNDS', (0, 1), (-1, -1), [colors.beige, colors.white])
+    ]))
+    elements.append(t)
+    
+    doc.build(elements)
+    print(f"Informe generado: {pdf_path}")
+
+if __name__ == "__main__":
+    generate_report()
